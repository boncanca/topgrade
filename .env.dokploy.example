# Dokploy Environment Configuration Template
APP_NAME="TopGrade FC"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://topgradefc.com

# Database Connection (PostgreSQL container in docker-compose)
DB_CONNECTION=pgsql
DB_HOST=clients-topgrade-db-nls8de
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=ey7wojertxqykrq6

# Redis & Horizon Queue Connection
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
HORIZON_PREFIX=topgrade_horizon:

# Administrator Bootstrap Credentials
ADMIN_NAME="TopGrade Club Admin"
ADMIN_EMAIL=info@topgradelondonfc.co.uk
ADMIN_PASSWORD=your_secure_admin_password
DEV_ADMIN_NAME="Technical Super Admin"
DEV_ADMIN_EMAIL=dev@trupabranding.com
DEV_ADMIN_PASSWORD=your_secure_dev_password

# Mail Driver Settings (SMTP / Resend / Mailgun / Postmark)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_YOUR_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@topgradefc.com
MAIL_FROM_NAME="TopGrade FC"

# Resend API Key for direct SDK & Mailer integration
RESEND_API_KEY=re_xxxxxxxxx

# Cloudinary Media Storage (Production)
MEDIA_DISK=cloudinary
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECURE_URL=true

