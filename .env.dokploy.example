# ==============================================================================
# Dokploy Production Environment Configuration
# Architecture: Nginx + PHP-FPM + OPcache + PostgreSQL + Cloudinary
# Application: TopGrade London FC
# ==============================================================================

# Core Application Settings
APP_NAME="TopGrade London FC"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://topgradelondonfc.co.uk

# Database Connection (PostgreSQL Container in Dokploy)
DB_CONNECTION=pgsql
DB_HOST=clients-topgrade-db-nls8de
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Application Storage Architecture: File Cache, Database Sessions, Database Queue
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

# Administrator Bootstrap Credentials (Synchronized deterministically on deploy)
ADMIN_NAME="TopGrade Club Admin"
ADMIN_EMAIL=info@topgradelondonfc.co.uk
ADMIN_PASSWORD=your_strong_admin_password
DEV_ADMIN_NAME="Technical Super Admin"
DEV_ADMIN_EMAIL=dev@trupabranding.com
DEV_ADMIN_PASSWORD=your_strong_dev_password

# Club Official Communication Inboxes
TOPGRADE_INFO_EMAIL=info@topgradelondonfc.co.uk
TOPGRADE_NO_REPLY_EMAIL=no-reply@topgradelondonfc.co.uk
TOPGRADE_BOOKINGS_EMAIL=bookings@topgradelondonfc.co.uk

# Transactional Mail Driver (Resend / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_YOUR_RESEND_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@topgradelondonfc.co.uk
MAIL_FROM_NAME="TopGrade London FC"

# Resend API Key (SDK & direct notifications)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Cloudinary Media Storage (Production Disk)
MEDIA_DISK=cloudinary
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECURE_URL=true

# Payment Processing Driver ('bank_transfer' or 'stripe')
PAYMENT_DRIVER=bank_transfer

# Club Bank Transfer Details for Booking Payments
BANK_ACCOUNT_NAME="TOPGRADE LONDON FC"
BANK_NAME="LLOYD'S BANK"
BANK_SORT_CODE="30-99-50"
BANK_ACCOUNT_NUMBER="20184968"

# Stripe Payment Processing (Optional: activate in future by setting PAYMENT_DRIVER=stripe)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

